DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/artist_exchange
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
RESEND_API_KEY=
# artistexchange.chburrows.com is verified in Resend, so this reaches any
# address, not just the Resend account owner's inbox. Fall back to
# `Artist Exchange <onboarding@resend.dev>` (Resend's zero-setup sandbox
# sender) only if testing without a verified domain.
EMAIL_FROM_ADDRESS=Artist Exchange <noreply@artistexchange.chburrows.com>
INTERNAL_JOB_TOKEN=
SESSION_SECRET=
ENVIRONMENT=local
# Origin allowed to make credentialed cross-origin requests to this API.
# The web app is a static export on a different host, so it is always
# cross-origin — set this to the deployed web URL in production.
WEB_ORIGIN=http://localhost:3000
